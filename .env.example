# URL da API para o painel. O backend tem o .env.example dele em backend/.
VITE_API_URL=http://localhost:8000

# Atalhos de login na tela do painel, so em desenvolvimento. Opcionais: sem eles
# os botoes nao aparecem. Use as senhas que o seed do backend imprimiu (ou as que
# voce definiu em SEED_*_PASSWORD).
VITE_DEMO_OPERATOR_EMAIL=operador@chargegrid.com.br
VITE_DEMO_OPERATOR_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=admin@chargegrid.com.br
VITE_DEMO_ADMIN_PASSWORD=

# Idem para o app do motorista.
EXPO_PUBLIC_DEMO_DRIVER_EMAIL=joao.silva@email.com
EXPO_PUBLIC_DEMO_DRIVER_PASSWORD=
