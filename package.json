{
  "name": "chargegrid",
  "version": "1.0.0",
  "private": true,
  "description": "ChargeGrid Intelligence — API, painel comercial e app do motorista (FIAP × GoodWe, EV Challenge 2026)",
  "type": "module",
  "workspaces": [
    "apps/admin",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:admin",
    "dev:admin": "npm run dev -w @chargegrid/admin",
    "dev:mobile": "npm start -w @chargegrid/mobile",
    "build": "npm run build:admin",
    "build:admin": "npm run build -w @chargegrid/admin",
    "preview": "npm run preview:admin",
    "preview:admin": "npm run preview -w @chargegrid/admin",
    "mobile": "npm run dev:mobile",
    "mobile:android": "npm run android -w @chargegrid/mobile",
    "mobile:ios": "npm run ios -w @chargegrid/mobile",
    "typecheck": "npm run typecheck -w @chargegrid/sdk && npm run typecheck -w @chargegrid/mobile",
    "verify:api": "npm run verify -w @chargegrid/sdk",
    "gen:types": "npm run gen:types -w @chargegrid/sdk",
    "infra:up": "docker compose --env-file apps/api/.env up --build -d",
    "infra:down": "docker compose --env-file apps/api/.env down",
    "infra:config": "docker compose --env-file apps/api/.env config --quiet"
  }
}
