# Molde do .env. Copie com `cp .env.example .env` e preencha os campos marcados
# com TROQUE-ME. Nenhum valor daqui serve para staging ou producao: a guarda em
# app/core/config.py recusa a subida se reconhecer um deles.
#
# ---- API ----
APP_NAME="ChargeGrid Intelligence API"
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Banco ----
# Use 127.0.0.1, nao localhost: no Windows o localhost resolve para ::1 (IPv6)
# antes do IPv4, e o Docker Desktop so publica a porta no IPv4 - conectar
# pelo IPv6 cai em outro processo e a conexao morre na negociacao SSL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chargegrid
# Sem valor padrao no codigo: defina uma senha aqui, mesmo em dev.
POSTGRES_PASSWORD=TROQUE-ME-senha-do-banco
POSTGRES_DB=chargegrid

# ---- Segurança ----
# Sem valor padrao no codigo. Gere a sua: openssl rand -hex 32
SECRET_KEY=TROQUE-ME-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Driver de hardware ----
# simulator | modbus
CHARGER_DRIVER=simulator
MODBUS_REGISTER_OFFSET=0
MODBUS_TIMEOUT_S=3.0

# ---- Workers ----
POLL_INTERVAL_S=5
# Tempo maximo que uma sessao espera na fila antes de liberar o ponto
QUEUE_TIMEOUT_MINUTES=30
POWER_REBALANCE_INTERVAL_S=15
ENABLE_WORKERS=true

# ---- Pagamento ----
# mock | pix | stripe
PAYMENT_PROVIDER=mock
# Sem valor padrao no codigo. Em staging/prod, use o segredo real do PSP.
PAYMENT_WEBHOOK_SECRET=TROQUE-ME-segredo-do-psp

# ---- Contas criadas pelo seed ----
# Deixe em branco para o seed sortear uma senha e imprimi-la uma unica vez.
# Preencha se quiser senhas estaveis entre recriacoes do banco.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_DRIVER_PASSWORD=
