{
  "expo": {
    "name": "ChargeGrid",
    "slug": "chargegrid",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chargegrid",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.chargegrid.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localizacao para ordenar as estacoes de recarga por distancia."
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "br.com.chargegrid.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "_comentario": "O mapa no Android usa Google Maps e exige chave propria. Sem ela o componente renderiza um quadro cinza - a lista de estacoes abaixo continua funcionando. Gere em console.cloud.google.com (Maps SDK for Android) e preencha googleMaps.apiKey. No iOS o mapa usa Apple Maps e nao precisa de chave.",
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
