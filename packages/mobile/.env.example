# O Expo le o .env do diretorio do proprio app, nao da raiz do workspace.
# Copie com `cp .env.example .env` aqui dentro de packages/mobile.

# Endereco da API. Deixe em branco e o app descobre sozinho o IP da maquina
# que serve o bundle (funciona com o Expo Go num celular na mesma rede).
#
# No EMULADOR do Android Studio, defina explicitamente: 10.0.2.2 e' o apelido
# que o emulador usa para alcancar o localhost da maquina hospedeira.
#   # Em branco, o app usa: (1) a maquina que serve o bundle, em desenvolvimento;
# (2) o dominio de config/dominios.json, num APK instalado.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# No simulador do iOS, localhost ja e' a maquina:
#   EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=

# Atalho de login em desenvolvimento. Opcional: sem os dois o formulario abre
# vazio. Use a senha que o seed do backend imprimiu (ou a de SEED_DRIVER_PASSWORD).
EXPO_PUBLIC_DEMO_DRIVER_EMAIL=joao.silva@email.com
EXPO_PUBLIC_DEMO_DRIVER_PASSWORD=

# Chave do Google Maps (Android). Sem ela o app mostra um aviso no lugar do mapa
# e a lista de estacoes continua funcionando. Restrinja a chave no Google Cloud
# pelo pacote e pela impressao digital do certificado - veja o README.
GOOGLE_MAPS_API_KEY=
