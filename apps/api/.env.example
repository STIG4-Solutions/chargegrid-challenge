# Molde do .env. Copie com `cp .env.example .env` e preencha os campos marcados
# com TROQUE-ME. Nenhum valor daqui serve para staging ou producao: a guarda em
# app/core/config.py recusa a subida se reconhecer um deles.
#
# ---- API ----
APP_NAME="ChargeGrid Intelligence API"
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
# Em branco, deriva de config/domains.json: o dominio do dashboard mais os
# enderecos locais. Defina para restringir ou acrescentar origens.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Banco ----
# Use 127.0.0.1, nao localhost: no Windows o localhost resolve para ::1 (IPv6)
# antes do IPv4, e o Docker Desktop so publica a porta no IPv4 - conectar
# pelo IPv6 cai em outro processo e a conexao morre na negociacao SSL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chargegrid
# Sem valor padrao no codigo: defina uma senha aqui, mesmo em dev.
POSTGRES_PASSWORD=TROQUE-ME-senha-do-banco
POSTGRES_DB=chargegrid

# ---- Segurança ----
# Sem valor padrao no codigo. Gere a sua: openssl rand -hex 32
SECRET_KEY=TROQUE-ME-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Driver de hardware ----
# simulator | modbus
CHARGER_DRIVER=simulator
MODBUS_REGISTER_OFFSET=0
MODBUS_TIMEOUT_S=3.0

# ---- Workers ----
POLL_INTERVAL_S=5
# Origem das leituras do medidor do site:
#   virtual - um worker sintetiza a curva do dia (nao ha medidor fisico ligado)
#   push    - so' aceita o que chegar por POST /power/meter-readings
METER_SOURCE=virtual
METER_INTERVAL_S=30
# Tempo maximo que uma sessao espera na fila antes de liberar o ponto
QUEUE_TIMEOUT_MINUTES=30
POWER_REBALANCE_INTERVAL_S=15
ENABLE_WORKERS=true
# Precificacao dinamica: a folga de potencia do site vira bandeira (verde 1,00 /
# amarela 1,15 / vermelha 1,30), travada na sessao. false = comportamento anterior.
PRECIFICACAO_DINAMICA=false

# ---- Pagamento ----
# mock | pix
PAYMENT_PROVIDER=mock
# Sem valor padrao no codigo. Em staging/prod, use o segredo real do PSP.
PAYMENT_WEBHOOK_SECRET=TROQUE-ME-segredo-do-psp

# ---- Assistente do operador (Azure OpenAI) ----
# Desligado, a API sobe normal e o widget some do painel. Ligado, os tres
# campos do Azure sao obrigatorios. AZURE_OPENAI_DEPLOYMENT e' o nome do
# deployment criado no recurso, e nao o nome do modelo.
ASSISTANT_ENABLED=false
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
AZURE_OPENAI_API_KEY=TROQUE-ME-chave-do-azure-openai
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Em branco = nao envia (modelos de raciocinio recusam temperatura).
AZURE_OPENAI_TEMPERATURE=0.2
# Cota por usuario: mensagens por minuto e por dia.
ASSISTANT_RATE_PER_MIN=6
ASSISTANT_RATE_PER_DAY=200
# Tetos de CUSTO em tokens (entrada + saida). Mensagem por dia nao limita gasto:
# uma pergunta com varias consultas custa dez comuns.
ASSISTANT_MAX_INPUT_TOKENS_PER_ANSWER=30000
ASSISTANT_DAILY_TOKENS_PER_USER=300000
ASSISTANT_DAILY_TOKENS_TOTAL=2000000

# ---- Contas criadas pelo seed ----
# Deixe em branco para o seed sortear uma senha e imprimi-la uma unica vez.
# Preencha se quiser senhas estaveis entre recriacoes do banco.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_DRIVER_PASSWORD=
