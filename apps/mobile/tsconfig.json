{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["jest"],
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/sdk/src/**/*.ts"],
  "exclude": ["node_modules", ".expo-bundle"]
}
