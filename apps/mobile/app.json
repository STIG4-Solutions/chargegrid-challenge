{
  "expo": {
    "name": "ChargeGrid",
    "slug": "chargegrid",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chargegrid",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.chargegrid.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localizacao para ordenar as estacoes de recarga por distancia.",
        "NSCameraUsageDescription": "Usamos a câmera apenas para ler o QR code colado no carregador e identificar a vaga."
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "br.com.chargegrid.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0F"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA"],
      "config": {
        "_comentario": "A chave do Google Maps NAO mora aqui: este arquivo e' versionado num repositorio publico. Ela e' injetada por app.config.js a partir de GOOGLE_MAPS_API_KEY. Veja o README."
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmera apenas para ler o QR code colado no carregador."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "0b934c0a-0971-4ccb-bcc2-425c278ba3b4"
      }
    },
    "owner": "ykushz"
  }
}
